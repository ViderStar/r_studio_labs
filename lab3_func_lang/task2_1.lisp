;;; Лабораторная работа №3 — Задание 2.1
;;; Вычисление математического выражения (вариант 1)
;;; sin((m*n+2)/(3*n) - tg(ln(4))) + 5*cos((n+m)/(20*n)) / e^(n*m)

(defun task-2-1 (m n)
  "Вычисляет математическое выражение для варианта 1."
  (+ (sin (- (/ (+ (* m n) 2)
               (* 3 n))
            (tan (log 4))))
     (/ (* 5 (cos (/ (+ n m)
                      (* 20 n))))
        (exp (* n m)))))

;; Тестовый запуск
(format t "Результат task-2-1 для m=2, n=3: ~A~%"
        (task-2-1 2 3))
(format t "Результат task-2-1 для m=1, n=1: ~A~%"
        (task-2-1 1 1))
