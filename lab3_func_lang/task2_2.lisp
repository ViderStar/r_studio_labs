;;; Лабораторная работа №3 — Задание 2.2
;;; Функция Y(x) с условным предложением COND (вариант 1)
;;; Y(x) = sin(x/a) + cos(a*x),  если x >= 3
;;;        ln(x),                  если 1 < x < 2

(defun y-func (x a)
  "Вычисляет Y(x) по условиям варианта 1.
   Константа a задаётся как аргумент функции."
  (cond
    ((>= x 3)
     (+ (sin (/ x a)) (cos (* a x))))
    ((and (> x 1) (< x 2))
     (log x))
    (t
     (format nil "Значение x=~A не входит в область определения" x))))

(defparameter a 2.0)

;; Тестовые запуски
(format t "Y(4, a=~A) = ~A~%" a (y-func 4 a))
(format t "Y(1.5, a=~A) = ~A~%" a (y-func 1.5 a))
(format t "Y(2.5, a=~A) = ~A~%" a (y-func 2.5 a))
