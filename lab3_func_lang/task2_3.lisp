;;; Лабораторная работа №3 — Задание 2.3
;;; Вычисление факториала заданного числа (вариант 1)
;;; Используется линейная (хвостовая) рекурсия

(defun factorial (n)
  "Вычисляет факториал числа n.
   Тип рекурсии: линейная (хвостовая) через вспомогательную функцию."
  (if (< n 0)
      (error "Факториал не определён для отрицательных чисел")
      (factorial-helper n 1)))

(defun factorial-helper (n acc)
  "Вспомогательная функция с аккумулятором для хвостовой рекурсии."
  (if (<= n 1)
      acc
      (factorial-helper (- n 1) (* acc n))))

;; Тестовые запуски
(format t "0! = ~A~%" (factorial 0))
(format t "1! = ~A~%" (factorial 1))
(format t "5! = ~A~%" (factorial 5))
(format t "10! = ~A~%" (factorial 10))
(format t "20! = ~A~%" (factorial 20))
